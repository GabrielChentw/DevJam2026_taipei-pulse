# 複製成 .env.local 後填入實際值。.env.local 已被 .gitignore 排除。
#
# Google Maps Platform API key。
# 必須在 GCP Console 啟用 "Maps JavaScript API" 且該專案已連結計費帳戶，
# 否則 Photorealistic 3D Tiles 不會出圖。
VITE_GOOGLE_MAPS_API_KEY=

# Maps JavaScript API 版本通道。
#
# 3D Maps (Map3DElement) 已進入正式版號（官方參考文件在 reference/3.63/3d-map），
# 所以 weekly 應該就有。alpha 是更早期的通道，不保證穩定。
#
# 若 3D 地圖載不出來，用這個頁面測哪個通道可用：
#   http://localhost:5173/maps-3d-test.html?key=YOUR_KEY
VITE_GOOGLE_MAPS_VERSION=weekly

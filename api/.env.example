# 複製成 .env 後填入實際值。api/app/main.py 用 python-dotenv 的 load_dotenv()
# 在啟動時自動讀取這個檔案，不需要手動 $env:GEMINI_API_KEY="..." 也可以。
#
# 注意檔名是 .env，不是 .env.local——跟 web/.env.local（前端的 Google Maps 金鑰）
# 是完全不同的檔案，用的是不同套件的預設命名慣例（python-dotenv vs Vite）。

# Gemini API 金鑰。到 https://aistudio.google.com/app/apikey 取得。
# 未設定時 /api/chat 會回 503，錯誤訊息會附上取得金鑰的連結。
GEMINI_API_KEY=

# 可選。預設 gemini-3.6-flash（截至 2026/08 為 GA 版本）。
# gemini-2.5-flash 已對新使用者下架，若又遇到 404 model not found，
# 到 https://ai.google.dev/gemini-api/docs/models 查目前可用的模型名稱。
TAIPEI_PULSE_MODEL=gemini-3.6-flash
